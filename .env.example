# DropWave environment configuration
#
# URL of the signaling server's WebSocket endpoint. The signaling server is used
# ONLY for the initial WebRTC handshake (SDP/ICE). It NEVER sees file data.
#
# Local dev (run `npm run signaling` in another terminal):
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# Production (deploy server/signaling to Fly.io — see server/signaling/fly.toml).
# Fly gives you TLS automatically, so use wss:// on port 443. Set this in your
# Vercel project's Environment Variables for the deployed app:
# NEXT_PUBLIC_SIGNALING_URL=wss://dropwave-signaling.fly.dev

# Optional: comma-separated STUN servers used for ICE. Defaults to Google's public
# STUN if unset. STUN only helps peers discover their public address; it relays no
# file data. On the same Wi-Fi the connection stays local.
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional but RECOMMENDED for a public deploy: a TURN relay so users on DIFFERENT
# networks (strict/symmetric NATs) can still connect when a direct P2P path can't be
# punched. TURN is the only point bytes may pass through a relay. Two ways to set it:
#
# (A) Dynamic credentials (recommended) — a free Metered account (metered.ca, no card)
#     gives an app subdomain + API key; the client fetches fresh, rotating creds.
#     The API key is meant to be used in the browser.
# NEXT_PUBLIC_METERED_SUBDOMAIN=yourapp        # the "<sub>.metered.live" prefix
# NEXT_PUBLIC_METERED_API_KEY=xxxxxxxxxxxxxxxx
#
# (B) Static credentials — paste a TURN URL + long-term username/credential from any
#     provider (or your own coturn).
# NEXT_PUBLIC_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-credential

# Port the signaling server listens on (server-side only; Fly sets PORT to 8080).
SIGNALING_PORT=8080
