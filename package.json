{
  "name": "dropwave",
  "version": "0.1.0",
  "private": true,
  "description": "Drop a file. It lands anywhere. — A true peer-to-peer file-sharing PWA over WebRTC.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "signaling": "node server/signaling/server.js",
    "dev:all": "concurrently -n web,signal -c cyan,magenta \"npm:dev\" \"npm:signaling\""
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.408.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
